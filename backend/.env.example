# Copy to .env and fill in values (never commit .env)

# MongoDB — local:
# MONGODB_URI=mongodb://localhost:27017/attention-monitoring
# MongoDB Atlas (URL-encode special characters in the password):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/attention-monitoring?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/attention-monitoring

PORT=5000

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

PYTHON_API_KEY=your_python_api_key_change_this

CORS_ORIGIN=http://localhost:5173
